<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\Bordadox.Core\Bordadox.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="SharpVectors.Wpf" Version="1.8.6" />
  </ItemGroup>

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <ApplicationIcon>Assets/bordadox.ico</ApplicationIcon>
    <AssemblyTitle>Bordadox</AssemblyTitle>
    <Description>Digitalizador de bordados para Brother NQ1400E</Description>
  </PropertyGroup>

  <ItemGroup>
    <Resource Include="Assets/bordadox.ico" />
  </ItemGroup>

</Project>
