<Window x:Class="Bordadox.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:Bordadox.App.Controls"
        xmlns:local="clr-namespace:Bordadox.App"
        Title="Bordadox" Icon="Assets/bordadox.ico" Height="860" Width="1400" MinWidth="900" MinHeight="560"
        WindowStartupLocation="CenterScreen" AllowDrop="True"
        Drop="Window_Drop" DragOver="Window_DragOver" Loaded="Window_Loaded" Closing="Window_Closing">

    <Window.CommandBindings>
        <CommandBinding Command="ApplicationCommands.New" Executed="New_Executed" />
        <CommandBinding Command="ApplicationCommands.Open" Executed="Open_Executed" />
        <CommandBinding Command="ApplicationCommands.Save" Executed="Save_Executed" />
        <CommandBinding Command="ApplicationCommands.SaveAs" Executed="SaveAs_Executed" />
        <CommandBinding Command="ApplicationCommands.Undo" Executed="Undo_Executed" />
        <CommandBinding Command="ApplicationCommands.Redo" Executed="Redo_Executed" />
        <CommandBinding Command="ApplicationCommands.Copy" Executed="Copy_Executed" />
        <CommandBinding Command="ApplicationCommands.Paste" Executed="Paste_Executed" />
        <CommandBinding Command="ApplicationCommands.SelectAll" Executed="SelectAll_Executed" />
        <CommandBinding Command="local:AppCommands.Export" Executed="Export_Executed" />
        <CommandBinding Command="local:AppCommands.Digitize" Executed="Digitize_Executed" />
        <CommandBinding Command="local:AppCommands.Duplicate" Executed="Duplicate_Executed" />
        <CommandBinding Command="local:AppCommands.Delete" Executed="Delete_Executed" />
        <CommandBinding Command="local:AppCommands.ZoomFit" Executed="ZoomFit_Executed" />
        <CommandBinding Command="local:AppCommands.ZoomIn" Executed="ZoomIn_Executed" />
        <CommandBinding Command="local:AppCommands.ZoomOut" Executed="ZoomOut_Executed" />
        <CommandBinding Command="local:AppCommands.ZoomActual" Executed="ZoomActual_Executed" />
        <CommandBinding Command="local:AppCommands.PlayPause" Executed="PlayPause_Executed" />
        <CommandBinding Command="local:AppCommands.ShowShortcuts" Executed="ShowShortcuts_Executed" />
    </Window.CommandBindings>

    <Window.InputBindings>
        <KeyBinding Command="ApplicationCommands.SaveAs" Modifiers="Ctrl+Shift" Key="S" />
        <KeyBinding Command="local:AppCommands.Export" Modifiers="Ctrl" Key="E" />
        <KeyBinding Command="local:AppCommands.Digitize" Modifiers="Ctrl" Key="I" />
        <KeyBinding Command="local:AppCommands.Duplicate" Modifiers="Ctrl" Key="D" />
        <KeyBinding Command="ApplicationCommands.Redo" Modifiers="Ctrl+Shift" Key="Z" />
        <KeyBinding Command="local:AppCommands.ShowShortcuts" Key="F1" />
    </Window.InputBindings>

    <Window.Resources>
        <Style TargetType="Button" x:Key="ToolButton">
            <Setter Property="Padding" Value="8,3" />
            <Setter Property="Margin" Value="1,0" />
            <Setter Property="MinWidth" Value="30" />
        </Style>
        <Style TargetType="RadioButton" x:Key="ToolRadio" BasedOn="{StaticResource {x:Type ToggleButton}}">
            <Setter Property="Height" Value="44" />
            <Setter Property="Margin" Value="4,2" />
            <Setter Property="GroupName" Value="Tools" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Focusable" Value="False" />
            <!-- Tempo para ler a explicação da ferramenta antes de ela sumir -->
            <Setter Property="ToolTipService.InitialShowDelay" Value="250" />
            <Setter Property="ToolTipService.ShowDuration" Value="30000" />
        </Style>
        <Style TargetType="ToolTip" x:Key="ToolHelp">
            <Setter Property="MaxWidth" Value="330" />
            <Setter Property="Padding" Value="9,7" />
        </Style>
        <!-- Explicação de cada ferramenta: o que ela faz, como usar e o atalho. Aparece ao passar o mouse. -->
        <ToolTip x:Key="TipSelecionar" Style="{StaticResource ToolHelp}">
            <StackPanel>
                <TextBlock Text="Selecionar e mover (V)" FontWeight="Bold" />
                <TextBlock TextWrapping="Wrap" Margin="0,3,0,0"
                           Text="Use para escolher, mover e ajustar os objetos. Clique num objeto para selecioná-lo; arraste para movê-lo; arraste sobre uma área vazia para selecionar vários. Ctrl ou Shift + clique soma objetos à seleção. Com um objeto selecionado, Ctrl + clique no contorno cria um ponto e duplo-clique num ponto apaga." />
            </StackPanel>
        </ToolTip>
        <ToolTip x:Key="TipCorrido" Style="{StaticResource ToolHelp}">
            <StackPanel>
                <TextBlock Text="Ponto corrido (R)" FontWeight="Bold" />
                <TextBlock TextWrapping="Wrap" Margin="0,3,0,0"
                           Text="Desenha uma linha de pontos simples, como um contorno fino ou um detalhe. Clique em cada ponto da linha; clique direito para uma curva. Enter ou duplo-clique termina; Esc cancela." />
            </StackPanel>
        </ToolTip>
        <ToolTip x:Key="TipSatin" Style="{StaticResource ToolHelp}">
            <StackPanel>
                <TextBlock Text="Coluna satin (C)" FontWeight="Bold" />
                <TextBlock TextWrapping="Wrap" Margin="0,3,0,0"
                           Text="Desenha uma faixa estreita e brilhante de pontos, ideal para letras e bordas. Clique alternando os dois lados da coluna (A, B, A, B...); clique direito para uma curva. Enter termina; Esc cancela." />
            </StackPanel>
        </ToolTip>
        <ToolTip x:Key="TipPreencher" Style="{StaticResource ToolHelp}">
            <StackPanel>
                <TextBlock Text="Preenchimento (F)" FontWeight="Bold" />
                <TextBlock TextWrapping="Wrap" Margin="0,3,0,0"
                           Text="Preenche uma área inteira com pontos (tatami ou satin), como um logo chapado. Clique no contorno da área, com cantos e curvas; Enter termina. Depois, em Propriedades, escolha o tipo de ponto, o ângulo e os efeitos (degradê, contorno, padrões)." />
            </StackPanel>
        </ToolTip>
        <ToolTip x:Key="TipAplique" Style="{StaticResource ToolHelp}">
            <StackPanel>
                <TextBlock Text="Aplique (A)" FontWeight="Bold" />
                <TextBlock TextWrapping="Wrap" Margin="0,3,0,0"
                           Text="Cria um aplique: um pedaço de tecido costurado sobre a peça. Desenhe o contorno do tecido. A máquina para em três passos: linha de posicionamento, fixação do tecido e acabamento em satin. Enter termina; Esc cancela." />
            </StackPanel>
        </ToolTip>
        <ToolTip x:Key="TipFuro" Style="{StaticResource ToolHelp}">
            <StackPanel>
                <TextBlock Text="Furo (H)" FontWeight="Bold" />
                <TextBlock TextWrapping="Wrap" Margin="0,3,0,0"
                           Text="Abre um furo num preenchimento, deixando o miolo sem pontos, como o centro da letra O. Selecione primeiro o preenchimento ou o aplique, depois desenhe o contorno do furo. Enter termina; Esc cancela." />
            </StackPanel>
        </ToolTip>
        <ToolTip x:Key="TipTexto" Style="{StaticResource ToolHelp}">
            <StackPanel>
                <TextBlock Text="Texto (T)" FontWeight="Bold" />
                <TextBlock TextWrapping="Wrap" Margin="0,3,0,0"
                           Text="Escreve um texto com as fontes instaladas no Windows. Clique onde a linha de base do texto deve começar, digite na janela e ajuste fonte, altura e espaçamento em Propriedades. Para editar um texto depois, use Selecionar e dê duplo-clique nele." />
            </StackPanel>
        </ToolTip>
        <Style TargetType="TextBlock" x:Key="PanelHeader">
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="8,8,8,4" />
            <Setter Property="Foreground" Value="#333" />
        </Style>
    </Window.Resources>

    <DockPanel>
        <Menu DockPanel.Dock="Top">
            <MenuItem Header="_Arquivo">
                <MenuItem Header="_Novo" Command="ApplicationCommands.New" InputGestureText="Ctrl+N" />
                <MenuItem Header="_Abrir..." Command="ApplicationCommands.Open" InputGestureText="Ctrl+O" />
                <MenuItem Header="_Salvar projeto" Command="ApplicationCommands.Save" InputGestureText="Ctrl+S" />
                <MenuItem Header="Salvar projeto _como..." Command="ApplicationCommands.SaveAs" InputGestureText="Ctrl+Shift+S" />
                <Separator />
                <MenuItem Header="_Exportar para a máquina (PES, DST, EXP, JEF, VP3)..." Command="local:AppCommands.Export" InputGestureText="Ctrl+E" />
                <MenuItem Header="_Ficha de produção (imprimir)..." Click="ProductionSheet_Click" ToolTip="Gera uma página com a prévia, o tamanho, os pontos, a sequência de linhas e o tempo estimado, para imprimir ou salvar como PDF." />
                <MenuItem Header="_Digitalizar imagem (logo/desenho)..." Command="local:AppCommands.Digitize" InputGestureText="Ctrl+I" />
                <MenuItem Header="_Inserir bordado no desenho..." Click="InsertEmbroidery_Click" />
                <Separator />
                <MenuItem Header="Imagem de _fundo">
                    <MenuItem Header="_Inserir imagem..." Click="InsertImage_Click" />
                    <MenuItem x:Name="ShowImageMenu" Header="_Mostrar" IsCheckable="True" IsChecked="True" Click="ShowImage_Click" />
                    <MenuItem Header="_Ajustar (propriedades)" Click="ImageProperties_Click" />
                    <MenuItem Header="_Remover" Click="RemoveImage_Click" />
                </MenuItem>
                <Separator />
                <MenuItem Header="_Sair" Click="Exit_Click" InputGestureText="Alt+F4" />
            </MenuItem>
            <MenuItem Header="_Editar">
                <MenuItem Header="_Desfazer" Command="ApplicationCommands.Undo" InputGestureText="Ctrl+Z" />
                <MenuItem Header="_Refazer" Command="ApplicationCommands.Redo" InputGestureText="Ctrl+Y" />
                <Separator />
                <MenuItem Header="_Copiar" Command="ApplicationCommands.Copy" InputGestureText="Ctrl+C" />
                <MenuItem Header="C_olar" Command="ApplicationCommands.Paste" InputGestureText="Ctrl+V" />
                <MenuItem Header="D_uplicar" Command="local:AppCommands.Duplicate" InputGestureText="Ctrl+D" />
                <MenuItem Header="_Excluir" Command="local:AppCommands.Delete" InputGestureText="Del" />
                <Separator />
                <MenuItem Header="_Selecionar tudo" Command="ApplicationCommands.SelectAll" InputGestureText="Ctrl+A" />
            </MenuItem>
            <MenuItem Header="_Objeto">
                <MenuItem Header="Girar 90° _horário" Click="RotateCw_Click" />
                <MenuItem Header="Girar 90° _anti-horário" Click="RotateCcw_Click" />
                <MenuItem Header="Girar por ân_gulo..." Click="RotateBy_Click" />
                <MenuItem Header="Espelhar _horizontal" Click="MirrorH_Click" />
                <MenuItem Header="Espelhar _vertical" Click="MirrorV_Click" />
                <MenuItem Header="_Redimensionar..." Click="Scale_Click" />
                <MenuItem Header="_Centralizar no bastidor" Click="Center_Click" />
                <Separator />
                <MenuItem Header="Converter em a_plique" Click="ToApplique_Click" ToolTip="Transforma o preenchimento selecionado num aplique (guia, fixação e acabamento)." />
                <MenuItem Header="Converter em pre_enchimento" Click="ToFill_Click" />
                <MenuItem Header="E_xplodir (separar em partes)" Click="Explode_Click" ToolTip="Separa o objeto selecionado em partes independentes: texto em letras, pontos importados em trechos, aplique e degradê em passos." />
                <Separator />
                <MenuItem Header="Costurar _antes" Click="SeqUp_Click" InputGestureText="Ctrl+↑" />
                <MenuItem Header="Costurar _depois" Click="SeqDown_Click" InputGestureText="Ctrl+↓" />
            </MenuItem>
            <MenuItem Header="E_xibir">
                <MenuItem Header="_Ajustar à tela" Command="local:AppCommands.ZoomFit" InputGestureText="0" />
                <MenuItem Header="_Tamanho real" Command="local:AppCommands.ZoomActual" InputGestureText="1" />
                <MenuItem Header="A_umentar zoom" Command="local:AppCommands.ZoomIn" InputGestureText="+" />
                <MenuItem Header="_Diminuir zoom" Command="local:AppCommands.ZoomOut" InputGestureText="-" />
                <Separator />
                <MenuItem x:Name="RotateHoopMenu" Header="_Bastidor deitado" IsCheckable="True" Click="RotateHoop_Click" InputGestureText="B" />
                <Separator />
                <MenuItem x:Name="ShowGridMenu" Header="_Grade" IsCheckable="True" IsChecked="True" Click="ViewOptions_Click" />
                <MenuItem x:Name="ShowJumpsMenu" Header="_Saltos de linha" IsCheckable="True" Click="ViewOptions_Click" />
                <MenuItem x:Name="ShowRulerMenu" Header="_Régua (mm)" IsCheckable="True" Click="ViewOptions_Click"
                          ToolTip="Mostra réguas em milímetros nas bordas da área de trabalho (zero no centro do bastidor). Use o zoom para ver os pontos em escala." />
            </MenuItem>
            <MenuItem Header="_Simulação">
                <MenuItem Header="_Reproduzir / pausar" Command="local:AppCommands.PlayPause" InputGestureText="P" />
                <MenuItem Header="_Ir para o início" Click="SimStart_Click" InputGestureText="Home" />
                <MenuItem Header="Ir para o _fim" Click="SimEnd_Click" InputGestureText="End" />
            </MenuItem>
            <MenuItem Header="_Ajuda">
                <MenuItem Header="_Atalhos do teclado..." Command="local:AppCommands.ShowShortcuts" InputGestureText="F1" />
            </MenuItem>
        </Menu>

        <ToolBarTray DockPanel.Dock="Top">
            <ToolBar>
                <Button Style="{StaticResource ToolButton}" Command="ApplicationCommands.New" Content="Novo" ToolTip="Novo desenho (Ctrl+N)" />
                <Button Style="{StaticResource ToolButton}" Command="ApplicationCommands.Open" Content="Abrir" ToolTip="Abrir projeto ou bordado (Ctrl+O)" />
                <Button Style="{StaticResource ToolButton}" Command="ApplicationCommands.Save" Content="Salvar" ToolTip="Salvar projeto .bdx (Ctrl+S)" />
                <Button Style="{StaticResource ToolButton}" Command="local:AppCommands.Digitize" Content="Digitalizar imagem" ToolTip="Transformar um logo (PNG, JPG, SVG) em bordado (Ctrl+I)" />
                <Button Style="{StaticResource ToolButton}" Command="local:AppCommands.Export" Content="Exportar" FontWeight="SemiBold" ToolTip="Gerar arquivo para a máquina (Ctrl+E)" />
            </ToolBar>
            <ToolBar>
                <Button Style="{StaticResource ToolButton}" Command="ApplicationCommands.Undo" Content="↶" ToolTip="Desfazer (Ctrl+Z)" />
                <Button Style="{StaticResource ToolButton}" Command="ApplicationCommands.Redo" Content="↷" ToolTip="Refazer (Ctrl+Y)" />
            </ToolBar>
            <ToolBar>
                <TextBlock Text="Bastidor:" VerticalAlignment="Center" Margin="4,0" />
                <ComboBox x:Name="HoopCombo" Width="170" SelectionChanged="HoopCombo_SelectionChanged" />
                <ToggleButton x:Name="RotateHoopButton" Padding="8,3" Margin="4,0,0,0" Click="RotateHoop_Click" Focusable="False"
                              ToolTip="Bastidor deitado (B). Ao exportar, o desenho é girado 90° para caber no bastidor da máquina.">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="⟳" Margin="0,0,4,0" />
                        <TextBlock Text="Deitado" />
                    </StackPanel>
                </ToggleButton>
            </ToolBar>
            <ToolBar>
                <Button Style="{StaticResource ToolButton}" Command="local:AppCommands.ZoomOut" Content="−" ToolTip="Diminuir zoom (-)" />
                <Button Style="{StaticResource ToolButton}" Command="local:AppCommands.ZoomIn" Content="+" ToolTip="Aumentar zoom (+)" />
                <Button Style="{StaticResource ToolButton}" Command="local:AppCommands.ZoomFit" Content="Ajustar" ToolTip="Ajustar à tela (0)" />
                <Button Style="{StaticResource ToolButton}" Command="local:AppCommands.ZoomActual" Content="1:1" ToolTip="Tamanho real (1)" />
            </ToolBar>
            <ToolBar>
                <Button Style="{StaticResource ToolButton}" Content="⏮" Click="SimStart_Click" ToolTip="Início (Home)" />
                <Button x:Name="PlayButton" Style="{StaticResource ToolButton}" Content="▶" Command="local:AppCommands.PlayPause" ToolTip="Simular costura (P)" />
                <Button Style="{StaticResource ToolButton}" Content="⏭" Click="SimEnd_Click" ToolTip="Fim (End)" />
                <Slider x:Name="SimSlider" Width="220" VerticalAlignment="Center" Margin="6,0"
                        Minimum="0" IsMoveToPointEnabled="True" ValueChanged="SimSlider_ValueChanged" Focusable="False" />
                <ComboBox x:Name="SpeedCombo" Width="110" SelectedIndex="1" ToolTip="Velocidade da simulação">
                    <ComboBoxItem Content="Lenta" Tag="1" />
                    <ComboBoxItem Content="Normal" Tag="6" />
                    <ComboBoxItem Content="Rápida" Tag="30" />
                    <ComboBoxItem Content="Muito rápida" Tag="150" />
                </ComboBox>
            </ToolBar>
        </ToolBarTray>

        <StatusBar DockPanel.Dock="Bottom">
            <StatusBarItem><TextBlock x:Name="StatusStitches" Text="Pontos: 0" /></StatusBarItem>
            <Separator />
            <StatusBarItem><TextBlock x:Name="StatusColors" Text="Cores: 0" /></StatusBarItem>
            <Separator />
            <StatusBarItem><TextBlock x:Name="StatusTrims" Text="Cortes: 0" /></StatusBarItem>
            <Separator />
            <StatusBarItem><TextBlock x:Name="StatusSize" Text="Tamanho: —" /></StatusBarItem>
            <Separator />
            <StatusBarItem><TextBlock x:Name="StatusWarning" Foreground="#C0392B" FontWeight="SemiBold" /></StatusBarItem>
            <StatusBarItem HorizontalAlignment="Right">
                <StackPanel Orientation="Horizontal">
                    <TextBlock x:Name="StatusCursor" Width="170" />
                    <TextBlock x:Name="StatusZoom" Width="90" TextAlignment="Right" />
                </StackPanel>
            </StatusBarItem>
        </StatusBar>

        <!-- Dica da ferramenta atual -->
        <Border DockPanel.Dock="Bottom" Background="#FFF8E1" BorderBrush="#E0D3A8" BorderThickness="0,1,0,0" Padding="8,3">
            <TextBlock x:Name="HintText" Foreground="#5D4E1F" TextTrimming="CharacterEllipsis" />
        </Border>

        <!-- Ferramentas -->
        <Border DockPanel.Dock="Left" Width="43" Background="#F3F3F3" BorderBrush="#DDD" BorderThickness="0,0,1,0">
            <StackPanel Margin="0,6">
                <RadioButton x:Name="ToolSelect" Style="{StaticResource ToolRadio}" Click="Tool_Click" Tag="Select" IsChecked="True" ToolTip="{StaticResource TipSelecionar}">
                    <StackPanel><TextBlock Text="↖" FontSize="12" HorizontalAlignment="Center" /></StackPanel>
                </RadioButton>
                <RadioButton x:Name="ToolRun" Style="{StaticResource ToolRadio}" Click="Tool_Click" Tag="Run" ToolTip="{StaticResource TipCorrido}">
                    <StackPanel><TextBlock Text="〰" FontSize="12" HorizontalAlignment="Center" /></StackPanel>
                </RadioButton>
                <RadioButton x:Name="ToolSatin" Style="{StaticResource ToolRadio}" Click="Tool_Click" Tag="Satin" ToolTip="{StaticResource TipSatin}">
                    <StackPanel><TextBlock Text="▥" FontSize="12" HorizontalAlignment="Center" /></StackPanel>
                </RadioButton>
                <RadioButton x:Name="ToolFill" Style="{StaticResource ToolRadio}" Click="Tool_Click" Tag="Fill" ToolTip="{StaticResource TipPreencher}">
                    <StackPanel><TextBlock Text="▦" FontSize="12" HorizontalAlignment="Center" /></StackPanel>
                </RadioButton>
                <RadioButton x:Name="ToolApplique" Style="{StaticResource ToolRadio}" Click="Tool_Click" Tag="Applique" ToolTip="{StaticResource TipAplique}">
                    <StackPanel><TextBlock Text="◧" FontSize="12" HorizontalAlignment="Center" /></StackPanel>
                </RadioButton>
                <RadioButton x:Name="ToolHole" Style="{StaticResource ToolRadio}" Click="Tool_Click" Tag="Hole" ToolTip="{StaticResource TipFuro}">
                    <StackPanel><TextBlock Text="◌" FontSize="12" HorizontalAlignment="Center" /></StackPanel>
                </RadioButton>
                <RadioButton x:Name="ToolText" Style="{StaticResource ToolRadio}" Click="Tool_Click" Tag="Text" ToolTip="{StaticResource TipTexto}">
                    <StackPanel><TextBlock Text="A" FontSize="12" FontWeight="Bold" HorizontalAlignment="Center" /></StackPanel>
                </RadioButton>
                <Separator Margin="6,8" />
                <TextBlock Text="Cor atual" FontSize="7.5" TextWrapping="Wrap" TextAlignment="Center" HorizontalAlignment="Center" Foreground="#555" />
                <Border x:Name="CurrentColorSwatch" Width="22" Height="22" CornerRadius="11" Margin="0,3"
                        BorderBrush="#888" BorderThickness="1" />
                <TextBlock x:Name="CurrentColorName" FontSize="8" TextWrapping="Wrap" TextAlignment="Center" Margin="4,0" />
            </StackPanel>
        </Border>

        <!-- Painel direito: objetos, propriedades, paleta -->
        <Border DockPanel.Dock="Right" Width="290" Background="#F3F3F3" BorderBrush="#DDD" BorderThickness="1,0,0,0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="2*" MinHeight="120" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="3*" MinHeight="120" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <DockPanel Grid.Row="0">
                    <DockPanel DockPanel.Dock="Top">
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Margin="0,4,6,0">
                            <Button Content="▲" Width="26" Click="SeqUp_Click" ToolTip="Costurar antes (Ctrl+↑)" Focusable="False" />
                            <Button Content="▼" Width="26" Margin="2,0" Click="SeqDown_Click" ToolTip="Costurar depois (Ctrl+↓)" Focusable="False" />
                            <Button Content="✕" Width="26" Command="local:AppCommands.Delete" ToolTip="Excluir (Del)" Focusable="False" />
                        </StackPanel>
                        <TextBlock Style="{StaticResource PanelHeader}" Text="Sequência de costura" />
                    </DockPanel>
                    <ListBox x:Name="ObjectList" Margin="4,0" SelectionMode="Extended"
                             SelectionChanged="ObjectList_SelectionChanged" BorderBrush="#DDD">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <DockPanel>
                                    <Border DockPanel.Dock="Left" Width="18" Height="18" CornerRadius="9" Margin="0,0,6,0"
                                            Background="{Binding Brush}" BorderBrush="#888" BorderThickness="1" />
                                    <TextBlock DockPanel.Dock="Right" Text="{Binding Detail}" Foreground="#888" FontSize="11" Margin="6,0,0,0" VerticalAlignment="Center" />
                                    <StackPanel>
                                        <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" />
                                        <TextBlock Text="{Binding Type}" Foreground="#777" FontSize="10" />
                                    </StackPanel>
                                </DockPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel>

                <GridSplitter Grid.Row="1" Height="5" HorizontalAlignment="Stretch" Background="#E4E4E4" />

                <DockPanel Grid.Row="2">
                    <TextBlock x:Name="PropertiesHeader" DockPanel.Dock="Top" Style="{StaticResource PanelHeader}" Text="Propriedades" />
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel>
                            <controls:PropertyEditor x:Name="Properties" />
                            <controls:PropertyEditor x:Name="ImageProperties" />
                        </StackPanel>
                    </ScrollViewer>
                </DockPanel>

                <StackPanel Grid.Row="3">
                    <TextBlock Style="{StaticResource PanelHeader}" Text="Linhas Brother" />
                    <ItemsControl x:Name="Palette" Margin="6,0,6,8">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button Width="22" Height="22" Margin="1" Background="{Binding Brush}" BorderBrush="#999"
                                        ToolTip="{Binding Label}" Tag="{Binding Thread}" Click="PaletteColor_Click" Focusable="False" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Grid>
        </Border>

        <controls:EmbroideryCanvas x:Name="Canvas" />
    </DockPanel>
</Window>
